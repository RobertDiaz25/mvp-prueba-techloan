# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube al repositorio.

# Contraseña de la base PostgreSQL (la usan docker compose y el backend)
DB_PASSWORD=cambia-esta-clave

# Contraseña de las cuentas ficticias de prueba (encargado, 20220001, 20220002).
# Déjala vacía si no quieres que se creen.
TECHLOAN_SEED_PASSWORD=cambia-esta-clave-demo
