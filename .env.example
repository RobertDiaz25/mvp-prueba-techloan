# Copia este archivo como .env (en esta misma carpeta) y pon tus valores.
# El archivo .env NO se sube al repositorio. El backend y docker compose lo leen solos.

# Usuario y contraseña de PostgreSQL para la base "techloan"
DB_USER=postgres
DB_PASSWORD=cambia-esta-clave

# Contraseña de las cuentas ficticias de prueba (encargado, 20220001, 20220002).
# Déjala vacía si no quieres que se creen.
TECHLOAN_SEED_PASSWORD=cambia-esta-clave-demo
